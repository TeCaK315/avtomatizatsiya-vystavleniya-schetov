# Resend API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email Configuration
# The email address that will appear as the sender
FROM_EMAIL=invoices@yourdomain.com

# OCR API Configuration (Optional - using Tesseract.js client-side)
# If you want to use a cloud OCR service instead, add credentials here
# OCR_API_KEY=your_ocr_api_key_here
# OCR_API_URL=https://api.ocr.space/parse/image

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Invoice Automation System