# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# OCR Service Configuration
# Tesseract.js is used for local OCR processing (no API key needed)
# For production, consider using cloud OCR services:
OCR_SERVICE_PROVIDER=tesseract
# OCR_API_KEY=your_ocr_api_key_here
# OCR_API_URL=https://api.ocr.space/parse/image

# Email Service Configuration (Nodemailer SMTP)
EMAIL_SERVICE_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Invoice Automation System

# Alternative: SendGrid
# EMAIL_SERVICE_PROVIDER=sendgrid
# SENDGRID_API_KEY=your_sendgrid_api_key

# Alternative: Mailgun
# EMAIL_SERVICE_PROVIDER=mailgun
# MAILGUN_API_KEY=your_mailgun_api_key
# MAILGUN_DOMAIN=your_mailgun_domain

# Database Configuration (Optional - using localStorage for prototype)
# MongoDB connection string for production
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/invoice-automation?retryWrites=true&w=majority
# MONGODB_DB_NAME=invoice-automation

# File Storage Configuration
# For prototype, files are stored as base64 in localStorage
# For production, use cloud storage:
# STORAGE_PROVIDER=local
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Integration Credentials (Accounting Systems)
# QuickBooks Online
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/integrations/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox

# Xero
XERO_CLIENT_ID=your_xero_client_id
XERO_CLIENT_SECRET=your_xero_client_secret
XERO_REDIRECT_URI=http://localhost:3000/api/integrations/xero/callback

# FreshBooks
FRESHBOOKS_CLIENT_ID=your_freshbooks_client_id
FRESHBOOKS_CLIENT_SECRET=your_freshbooks_client_secret
FRESHBOOKS_REDIRECT_URI=http://localhost:3000/api/integrations/freshbooks/callback

# Security
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_for_credentials

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Logging
LOG_LEVEL=info
# LOG_FILE_PATH=./logs/app.log

# Feature Flags
ENABLE_AUTO_SYNC=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_CLOUD_STORAGE=false
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png