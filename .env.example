# OCR API Configuration
# For Tesseract.js (client-side OCR) - no API key needed
# If using cloud OCR service (Google Vision, AWS Textract), add keys here:
# OCR_API_KEY=your_api_key_here
# OCR_API_ENDPOINT=https://api.example.com/ocr

# Email Service Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@yourdomain.com

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Invoice Automation System

# Storage Configuration
# For prototype: localStorage (client-side)
# For production: add database connection string
# DATABASE_URL=mongodb://localhost:27017/invoices
# or
# DATABASE_URL=postgresql://user:password@localhost:5432/invoices

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=application/pdf

# Invoice Configuration
DEFAULT_TAX_RATE=0.20
DEFAULT_CURRENCY=USD
INVOICE_NUMBER_PREFIX=INV
INVOICE_DUE_DAYS=30

# Feature Flags
ENABLE_OCR=true
ENABLE_EMAIL=true
ENABLE_PDF_GENERATION=true